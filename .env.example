# Database connection URL. Update with your actual connection string in production.
DATABASE_URL="postgresql://user:password@localhost:5432/salon_db?schema=public"

# NextAuth secret for JWT encryption (if you implement authentication).
NEXTAUTH_SECRET="supersecret"

# Base URL for the application, used in emails/links.
NEXTAUTH_URL="http://localhost:3000"
# Password for /admin login. Change it before publishing.
ADMIN_PASSWORD="admin123"
